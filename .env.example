# === Database ===
# MongoDB Atlas connection string (production). Falls back to the local URI
# below if this is unset.
MONGODB_URI=mongodb://localhost:27017/ems
MONGODB_DB_NAME=ems_hrms
# Local development fallback (used automatically when MONGODB_URI is not set)
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/ems_hrms

# === Session / Auth ===
# Long random string used as part of session token generation. Generate with: openssl rand -hex 64
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_NAME=ems_session
SESSION_MAX_AGE_SECONDS=604800

# PBKDF2 password hashing tuning
PBKDF2_ITERATIONS=210000
PBKDF2_KEYLEN=64
PBKDF2_DIGEST=sha256

# === 2FA OTP ===
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# === Seed script (npm run seed) ===
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123

# === App ===
NODE_ENV=development
